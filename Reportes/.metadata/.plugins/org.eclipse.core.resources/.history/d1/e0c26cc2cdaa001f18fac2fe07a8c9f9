	<parameter name="fechaInicio" class="java.util.Date"/>
	<parameter name="fechaFin" class="java.util.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT ferreteria.productos.`ProductoID`,
	ferreteria.productos.`Nombre`,
	SUM( ferreteria.detalleventas.`Cantidad`) AS Vendido,
	ferreteria.ventas.`Fecha`
FROM ferreteria.detalleventas
	JOIN ferreteria.ventas ON 
	 ferreteria.detalleventas.`VentaID` = ferreteria.ventas.`VentaID` 
	JOIN ferreteria.productos ON 
	 ferreteria.detalleventas.`ProductoID` = ferreteria.productos.`ProductoID` 
WHERE 
	 ferreteria.ventas.`Fecha` BETWEEN  $P{fechaInicio}  AND $P{fechaFin}
GROUP BY ferreteria.productos.`ProductoID`,
	ferreteria.productos.`Nombre`,
	ferreteria.ventas.`Fecha`
ORDER BY Vendido DESC]]>
	</queryString>
